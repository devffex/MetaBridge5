# ==============================================================================
# MetaBridge5 Market Gateway - Environment Configuration Template
# ==============================================================================

# 1. Core API Security & Remote Desktop
METABRIDGE5_API_KEY=your_secret_api_key_here
VNC_PASSWORD=metabridge5pass

# 2. MT5 Daemon Connectivity
MT5_GRPC_SERVER=127.0.0.1:50051

# 3. Asset Ingestion & Startup Watchlist
# Comma-separated assets to activate and stream on boot, or '*' / 'ALL_ACTIVE'
METABRIDGE5_SYMBOLS=EURUSD,GBPUSD,USDJPY
# Automatically trigger initial historical backfill on container boot for above symbols
METABRIDGE5_AUTO_BACKFILL_ON_START=false
# Scheduled multi-timeframe dataset rollup interval (e.g. 'D1', 'H1', 'M15')
METABRIDGE5_SYNC_INTERVAL=D1

# 4. Storage Strategy & Target
# Options: 'github' (Free CDN) | 's3' (Cloudflare R2 / AWS S3) | 'local'
STORAGE_BACKEND=github

# 4. GitHub & jsDelivr Multi-CDN Storage Backend (Used when STORAGE_BACKEND=github)
GITHUB_TOKEN=ghp_yourGitHubPersonalAccessToken
GITHUB_REPO=devffex/dataset
GITHUB_BRANCH=main
GITHUB_CDN_BASE_URL=https://cdn.jsdelivr.net/gh/devffex/dataset@main

# 5. Audit Logging & Telemetry Strategy
# Options: 'sqlite' (Local WAL mode) | 'external' (Remote DB/Loki) | 'both' | 'none'
AUDIT_LOG_SINK=sqlite
AUDIT_EXTERNAL_ENDPOINT=
AUDIT_EXTERNAL_API_KEY=

# 6. S3 / Cloudflare R2 Settings (Used when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=metabridge5-market-data
S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_CDN_BASE_URL=

# 7. System Runtime & Insulation Settings
TZ=UTC
WINEDEBUG=-all
