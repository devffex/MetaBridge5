# ==========================================
# STAGE 1: Font Builder
# ==========================================
FROM alpine:3.20 AS font-builder

RUN apk add --no-cache --repository http://dl-cdn.alpinelinux.org/alpine/edge/community \
    msttcorefonts-installer \
    && update-ms-fonts

# ==========================================
# STAGE 2: Python Builder (Offline Windows Packages)
# ==========================================
FROM alpine:3.20 AS python-builder

ARG GRPC_VERSION=1.62.2
ARG PROTOBUF_VERSION=4.25.3
ARG NUMPY_VERSION=1.26.4
ARG PSUTIL_VERSION=5.9.8

RUN apk add --no-cache python3 py3-pip curl unzip && \
    pip install --no-cache-dir --break-system-packages grpcio-tools==${GRPC_VERSION}

# 1. Download and extract Windows Python embeddable
RUN curl -fsSL https://www.python.org/ftp/python/3.11.9/python-3.11.9-embed-amd64.zip -o /tmp/python.zip && \
    mkdir -p /tmp/python/Lib/site-packages && \
    unzip -q /tmp/python.zip -d /tmp/python && \
    rm /tmp/python.zip && \
    sed -i 's/#import site/import site/' /tmp/python/python311._pth && \
    echo ".\\Lib\\site-packages" >> /tmp/python/python311._pth && \
    echo "..\\daemon" >> /tmp/python/python311._pth

# 2. Download and unpack Windows amd64 wheels directly on native Linux (no pandas/tzdata/pytz/pip/setuptools)
RUN mkdir -p /tmp/wheels && \
    pip download --dest /tmp/wheels \
        --only-binary=:all: \
        --platform win_amd64 \
        --python-version 3.11 \
        --implementation cp \
        --abi cp311 \
        grpcio==${GRPC_VERSION} protobuf==${PROTOBUF_VERSION} numpy==${NUMPY_VERSION} MetaTrader5 psutil==${PSUTIL_VERSION} && \
    for whl in /tmp/wheels/*.whl; do unzip -q -o "$whl" -d /tmp/python/Lib/site-packages/; done && \
    find /tmp/python/Lib/site-packages -type d \( -name "*.dist-info" -o -name "test" -o -name "tests" -o -name "__pycache__" \) -exec rm -rf {} + && \
    rm -rf /tmp/wheels

# 3. Generate gRPC stubs natively on Linux
COPY docker/daemon/protos /tmp/daemon/protos
RUN mkdir -p /tmp/daemon && \
    python3 -m grpc_tools.protoc -I/tmp/daemon/protos \
        --python_out=/tmp/daemon --grpc_python_out=/tmp/daemon \
        /tmp/daemon/protos/terminal.proto



# ==========================================
# STAGE 3: Go Supervisor Builder
# ==========================================
FROM golang:1.22-alpine3.20 AS supervisor-builder
RUN apk add --no-cache git && \
    git clone https://github.com/ochinchina/supervisord.git /src && \
    cd /src && \
    CGO_ENABLED=0 go build -ldflags "-s -w" -o /go/bin/supervisord



# ==========================================
# STAGE 4: Final Runtime Base Image
# ==========================================
FROM alpine:3.20

# Combine apk packages to reduce layer overhead (Removed curl, unzip, supervisor, python3)
RUN apk add --no-cache \
    bash \
    xvfb \
    freetype \
    fontconfig \
    x11vnc \
    wine \
    gnutls \
    ca-certificates \
    tzdata \
    xdotool \
    libfaketime \
    tini \
    su-exec && \
    rm -rf /usr/lib/wine/i386-windows

# Copy the compiled Go supervisord binary
COPY --from=supervisor-builder /go/bin/supervisord /usr/bin/supervisord

# Set up user and environment variables for Wine
ENV WINEPREFIX=/home/wine/.wine
ENV WINEARCH=win64
ENV DISPLAY=:1
ENV WINEDLLOVERRIDES="mscoree,mshtml,winemenubuilder.exe=disabled"
# Prevent Python from writing bytecode at runtime
ENV PYTHONDONTWRITEBYTECODE=1
# Globally silence verbose Wine logging
ENV WINEDEBUG=-all
# Default credentials for development (can be overridden via docker run -e)
ENV VNC_PASSWORD=metabridge5pass
ENV METABRIDGE5_API_KEY=dev_metabridge5_secret_key_123

# Create wine user and workspaces
RUN adduser -D -u 1000 wine && \
    mkdir -p /home/wine/.wine /opt/metabridge5 /opt/wine-seed && \
    chown -R wine:wine /home/wine /opt/metabridge5 /opt/wine-seed

# Copy the compiled Microsoft fonts from Stage 1
COPY --from=font-builder /usr/share/fonts/truetype/msttcorefonts/ /usr/share/fonts/truetype/msttcorefonts/

# Rebuild font cache
RUN fc-cache -f

# Copy supervisord configuration and helper scripts
COPY docker/supervisord.conf /etc/supervisord.conf
COPY --chown=wine:wine docker/supervisord/startup_guard.sh /opt/metabridge5/startup_guard.sh
COPY --chown=wine:wine docker/supervisord/vnc_passwd_setup.sh /opt/metabridge5/vnc_passwd_setup.sh
COPY --chown=wine:wine docker/supervisord/xvfb_launcher.sh /opt/metabridge5/xvfb_launcher.sh
COPY --chown=wine:wine docker/supervisord/vnc_launcher.sh /opt/metabridge5/vnc_launcher.sh
COPY --chown=wine:wine docker/supervisord/terminal_wrapper.sh /opt/metabridge5/terminal_wrapper.sh
COPY --chown=wine:wine docker/supervisord/entrypoint.sh /opt/metabridge5/entrypoint.sh
COPY --chown=wine:wine docker/daemon/grpc_server.py /opt/metabridge5/daemon/grpc_server.py
RUN chmod +x /opt/metabridge5/startup_guard.sh /opt/metabridge5/vnc_passwd_setup.sh /opt/metabridge5/xvfb_launcher.sh /opt/metabridge5/vnc_launcher.sh /opt/metabridge5/terminal_wrapper.sh /opt/metabridge5/entrypoint.sh

# Copy portable MetaTrader 5 from host (redundant binaries are filtered by .dockerignore)
COPY --chown=wine:wine MetaTrader5/ /opt/metabridge5/MetaTrader5/

# Configure system timezone name for Wine's timezone auto-detection
RUN echo "UTC" > /etc/timezone

# Clean up any pre-baked host-specific terminal license and account cache
RUN rm -f /opt/metabridge5/MetaTrader5/Config/terminal.lic \
          /opt/metabridge5/MetaTrader5/Config/accounts.dat

# Create the VNC password directory, set permissions, and pre-bake default passwords
RUN mkdir -p /home/wine/.vnc && \
    printf "metabridge5pass\nMetabridge5Pass\nMetaBridge5Pass\n" > /home/wine/.vnc/passwdfile && \
    x11vnc -storepasswd metabridge5pass /home/wine/.vnc/passwd && \
    chmod 600 /home/wine/.vnc/passwdfile /home/wine/.vnc/passwd && \
    chown -R wine:wine /home/wine/.vnc

# Copy Python runtime base and generated stubs (from python-builder)
COPY --chown=wine:wine --from=python-builder /tmp/python/ /opt/metabridge5/python/
COPY --chown=wine:wine --from=python-builder /tmp/daemon/terminal_pb2*.py /opt/metabridge5/daemon/

# Copy certificate importer script
COPY --chown=wine:wine docker/import_certs.py /opt/metabridge5/import_certs.py

# Single command layer: Run Wine initialization, registry setup, and cert import as wine user, then seed
RUN mkdir -p /home/wine/.wine/dosdevices && \
    ln -sfn /opt/metabridge5 /home/wine/.wine/dosdevices/m: && \
    su -s /bin/bash wine -c 'wineboot --init && \
        wine reg add "HKLM\\Software\\Microsoft\\Cryptography\\Defaults\\Provider Types\\Type 024" /v Name /t REG_SZ /d "Microsoft Enhanced RSA and AES Cryptographic Provider" /f && \
        wine reg add "HKLM\\Software\\Microsoft\\Cryptography\\Defaults\\Provider Types\\Type 024" /v TypeName /t REG_SZ /d "RSA Full and AES" /f && \
        wine reg add "HKLM\\Software\\Microsoft\\Cryptography\\Defaults\\Provider\\Microsoft Enhanced RSA and AES Cryptographic Provider" /v "Image Path" /t REG_SZ /d "rsaenh.dll" /f && \
        wine reg add "HKLM\\Software\\Microsoft\\Cryptography\\Defaults\\Provider\\Microsoft Enhanced RSA and AES Cryptographic Provider" /v Type /t REG_DWORD /d 24 /f && \
        wine reg add "HKLM\\Software\\Microsoft\\Cryptography\\Defaults\\Provider\\Microsoft Enhanced RSA and AES Cryptographic Provider" /v SigInFile /t REG_DWORD /d 0 /f && \
        wine M:\\python\\python.exe M:\\import_certs.py && \
        wineserver -w' && \
    # 2. Reclaim ownership and delete cert script (now back as root)
    rm -f /opt/metabridge5/import_certs.py && \
    # Remove pycache recursively
    find /opt/metabridge5/python -type d -name "__pycache__" -exec rm -rf {} + && \
    # Remove intermediate wineserver build-time socket files
    rm -rf /tmp/.wine-1000 && \
    # Insulate prefix by deleting container root traversal symlink
    rm -f /home/wine/.wine/dosdevices/z: && \
    # Disable LiveUpdate by blocking its directory in both the installation path and AppData
    rm -rf /opt/metabridge5/MetaTrader5/liveupdate && \
    touch /opt/metabridge5/MetaTrader5/liveupdate && \
    chmod 444 /opt/metabridge5/MetaTrader5/liveupdate && \
    mkdir -p /home/wine/.wine/drive_c/users/wine/AppData/Roaming/MetaQuotes/Terminal/BF9336D047DCCACD9080FDBCE04D3DE5 && \
    rm -rf /home/wine/.wine/drive_c/users/wine/AppData/Roaming/MetaQuotes/Terminal/BF9336D047DCCACD9080FDBCE04D3DE5/liveupdate && \
    touch /home/wine/.wine/drive_c/users/wine/AppData/Roaming/MetaQuotes/Terminal/BF9336D047DCCACD9080FDBCE04D3DE5/liveupdate && \
    chmod 444 /home/wine/.wine/drive_c/users/wine/AppData/Roaming/MetaQuotes/Terminal/BF9336D047DCCACD9080FDBCE04D3DE5/liveupdate && \
    # Seed the initialized Wine prefix template
    cp -a /home/wine/.wine/. /opt/wine-seed/ && \
    chown -R wine:wine /opt/wine-seed /opt/metabridge5 /home/wine


WORKDIR /home/wine

EXPOSE 5900 50051

ENTRYPOINT ["/sbin/tini", "--", "/opt/metabridge5/entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
